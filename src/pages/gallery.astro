---
import BaseLayout from '../layouts/BaseLayout.astro';
import MasonryGallery from '../components/MasonryGallery.astro';
import Lightbox from '../components/Lightbox.astro';
import { photos } from '../lib/gallery';
---

<BaseLayout title="作品" description="完整摄影作品墙。点击任意一张照片进入全屏浏览。">
  <section class="section">
    <div class="shell">
      <header class="section-head">
        <h1 class="section-title reveal">作品</h1>
        <p class="meta reveal">点击照片全屏浏览</p>
      </header>

      {
        photos.length > 0 ? (
          <MasonryGallery items={photos} />
        ) : (
          <p class="body-text">目前还没有照片。把照片放进 iCloud「精品集」文件夹，再运行导入脚本即可。</p>
        )
      }
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<script>
  import '../scripts/masonry';
</script>
