---
import BaseLayout from '../layouts/BaseLayout.astro';
import MasonryGallery from '../components/MasonryGallery.astro';
import Lightbox from '../components/Lightbox.astro';
import { photos } from '../lib/gallery';
import { getLang, t } from '../lib/i18n';

const ui = t(getLang(Astro.url));
---

<BaseLayout title={ui.pageWorksTitle}>
  <section class="section">
    <div class="shell">
      <header class="section-head">
        <h1 class="section-title reveal">{ui.pageWorksTitle}</h1>
        <p class="meta reveal">{ui.pageWorksHint}</p>
      </header>

      {
        photos.length > 0 ? (
          <MasonryGallery items={photos} />
        ) : (
          <p class="body-text">{ui.emptyGallery}</p>
        )
      }
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<script>
  import '../scripts/masonry';
</script>
