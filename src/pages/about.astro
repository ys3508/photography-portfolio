---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { withBase } from '../lib/paths';
import { photos } from '../lib/gallery';
import MarbleGround from '../components/MarbleGround.astro';
---

<BaseLayout title="关于" description={`关于摄影师 ${SITE.photographerName}`}>
  <section class="section about-page">
    <MarbleGround variant="statement" />

    <div class="shell above-ground">
      <header class="section-head">
        <h1 class="section-title reveal">关于摄影师</h1>
        <p class="meta reveal">{photos.length} 张作品</p>
      </header>

      <div class="about-grid">
        <figure class="portrait reveal clip-reveal">
          <span class="frame portrait-frame">
            <img
              src={withBase(SITE.portrait)}
              alt={SITE.portraitAlt}
              sizes="(max-width: 860px) 70vw, 32vw"
              loading="eager"
              decoding="async"
              data-loaded="false"
            />
          </span>
          <figcaption class="meta cap">{SITE.photographerName}　{SITE.photographerNameLatin}</figcaption>
        </figure>

        <div class="prose">
          <figure class="seal seal-lg reveal">
            <span class="seal-mark">{SITE.motto}</span>
            <figcaption class="seal-latin">{SITE.mottoLatin}</figcaption>
          </figure>
          {SITE.statement && (
            <p class="body-text reveal" style="--reveal-delay: 120ms">{SITE.statement}</p>
          )}
          {SITE.aboutExtra && (
            <p class="body-text reveal" style="--reveal-delay: 200ms">{SITE.aboutExtra}</p>
          )}
          <p class="reveal" style="--reveal-delay: 280ms">
            <a class="link" href={withBase('gallery')}>查看全部作品</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    position: relative;
    overflow: hidden;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .portrait {
    margin: 0;
    max-width: 30rem;
  }

  .portrait-frame {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--photo-rest);
    cursor: default;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cap {
    margin-top: 0.9rem;
    letter-spacing: 0.18em;
  }

  .prose {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .prose p {
    margin: 0;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 20rem;
    }
  }
</style>
