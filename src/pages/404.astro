---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, localePath, t } from '../lib/i18n';

const lang = getLang(Astro.url);
const ui = t(lang);
---

<BaseLayout title={ui.notFoundTitle}>
  <section class="section">
    <div class="shell center">
      <p class="eyebrow">404</p>
      <h1 class="section-title">{ui.notFoundTitle}</h1>
      <p class="body-text">{ui.notFoundBody}</p>
      <p><a class="link" href={localePath(lang)}>{ui.notFoundCta}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .center {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: clamp(4rem, 14vh, 9rem);
  }
  .center p {
    margin: 0;
  }
</style>
