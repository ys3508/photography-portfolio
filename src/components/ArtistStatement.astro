---
/**
 * 摄影陈述。
 *
 * 首页封面已经有「思 / Think and feel the world」那方印了，
 * 所以这一节只在王宇本人写了陈述文字之后才出现 —— 而且不再重复那个字，
 * 免得同一屏里说两遍同一句话。
 */
import { SITE } from '../config/site';
import MarbleGround from './MarbleGround.astro';

const hasStatement = SITE.statement.trim().length > 0;
---

{
  hasStatement && (
    <section class="statement section" aria-labelledby="statement-title">
      <MarbleGround variant="statement" />

      <div class="shell inner above-ground">
        <p class="eyebrow reveal" id="statement-title">
          摄影陈述
        </p>

        <blockquote class="text reveal" style="--reveal-delay: 140ms">
          {SITE.statement}
        </blockquote>

        <p class="sign reveal" style="--reveal-delay: 240ms">
          — {SITE.photographerName}
        </p>
      </div>
    </section>
  )
}

<style>
  .statement {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }

  .inner {
    display: grid;
    justify-items: start;
    gap: clamp(2rem, 4.5vw, 3.5rem);
    max-width: 46rem;
  }

  .text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    line-height: 1.9;
    font-weight: 300;
  }

  .sign {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    color: var(--text-muted);
  }
</style>
