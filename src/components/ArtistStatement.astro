---
import { SITE } from '../config/site';
import MarbleGround from './MarbleGround.astro';
---

<section class="statement section" aria-labelledby="statement-title">
  <MarbleGround variant="statement" />

  <div class="shell inner above-ground">
    <p class="eyebrow reveal" id="statement-title">Artist Statement · 摄影陈述</p>

    <figure class="seal seal-lg seal-center reveal" style="--reveal-delay: 120ms">
      <span class="seal-mark">{SITE.motto}</span>
      <figcaption class="seal-latin">{SITE.mottoLatin}</figcaption>
    </figure>

    {
      SITE.statement && (
        <blockquote class="text reveal" style="--reveal-delay: 240ms">
          {SITE.statement}
        </blockquote>
      )
    }

    <p class="sign reveal" style="--reveal-delay: 320ms">— {SITE.photographerName}</p>
  </div>
</section>

<style>
  .statement {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 52rem;
    text-align: center;
  }

  .text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    line-height: 1.9;
    font-weight: 300;
    max-width: 30em;
  }

  .sign {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    color: var(--text-muted);
  }
</style>
