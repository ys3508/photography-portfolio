---
import { SITE } from '../config/site';
import { getLang, localePath, t } from '../lib/i18n';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';

const lang = getLang(Astro.url);
const ui = t(lang);

const NAV = [
  { label: ui.navWorks, href: 'gallery' },
  { label: ui.navSelected, href: '#featured' },
  { label: ui.navAbout, href: 'about' },
];

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const current = Astro.url.pathname.replace(/\/+$/, '');
function isActive(href: string) {
  if (href.startsWith('#')) return false;
  return current.endsWith(`/${href}`);
}
---

<header class:list={['site-header', overlay && 'is-overlay']} data-site-header>
  <div class="bar shell">
    <a class="brand" href={localePath(lang)}>
      {lang === 'en' ? SITE.photographerNameLatin : SITE.photographerName}
    </a>

    <nav class="nav" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            class:list={['nav-link', isActive(item.href) && 'is-active']}
            href={item.href.startsWith('#') ? localePath(lang) + item.href : localePath(lang, item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <LangToggle />
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--theme-duration) var(--ease),
      border-color 500ms var(--ease),
      color var(--theme-duration) var(--ease);
  }

  /* 首页：起始完全透明，滚动之后才浮现，不遮挡封面 */
  .site-header.is-overlay {
    position: fixed;
    inset-inline: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header.is-overlay.is-stuck {
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom-color: var(--line);
  }

  .site-header:not(.is-overlay).is-stuck {
    border-bottom-color: var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.25rem);
  }

  .nav-link {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    padding-block: 0.4rem;
    transition: color 400ms var(--ease);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.15rem;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 450ms var(--ease);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  /*
    只在宽屏上生效：窄屏的朱染收在最外侧，导航那里是浅色的。
    首页顶部导航是完全透明的，而在宽屏上它正好落在朱染的深色那一侧，
    所以这时候导航文字用象牙色；一旦滚动、导航条浮出浅色背景，就换回深色。
    左边的品牌名一直在浅色区（大理石那半边），保持深色不变。
  */
  @media (min-width: 861px) {
    .site-header.is-overlay:not(.is-stuck) .nav-link {
      color: rgba(244, 242, 236, 0.74);
    }

    .site-header.is-overlay:not(.is-stuck) .nav-link:hover,
    .site-header.is-overlay:not(.is-stuck) .nav-link.is-active {
      color: #f4f2ec;
    }

    .site-header.is-overlay:not(.is-stuck) :global(.theme-toggle),
    .site-header.is-overlay:not(.is-stuck) :global(.lang) {
      color: rgba(244, 242, 236, 0.85);
    }

    .site-header.is-overlay:not(.is-stuck) :global(.lang:hover) {
      color: #f4f2ec;
    }
  }

  /*
    窄屏：英文导航（Works / Selected / About）比中文长，加上语言与日夜两个按钮，
    在 390px 上会把日夜按钮挤出屏幕。这里统一收一档，保证一行装得下。
  */
  @media (max-width: 560px) {
    .bar {
      gap: 0.5rem;
      min-height: 3.75rem;
    }

    .brand {
      font-size: 1rem;
      letter-spacing: 0.08em;
    }

    .nav {
      gap: 0.6rem;
    }

    .nav-link {
      font-size: 0.8125rem;
      letter-spacing: 0.02em;
    }

    .nav :global(.lang) {
      min-width: 2rem;
      height: 2rem;
      padding-inline: 0.25rem;
      font-size: 0.8125rem;
    }

    .nav :global(.theme-toggle) {
      width: 2rem;
      height: 2rem;
      font-size: 0.9375rem;
    }
  }

  @media (max-width: 380px) {
    .brand {
      font-size: 0.9375rem;
      letter-spacing: 0.04em;
    }

    .nav {
      gap: 0.45rem;
    }

    .nav-link {
      font-size: 0.75rem;
    }
  }
</style>
