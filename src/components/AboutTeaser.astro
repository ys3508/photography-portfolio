---
/** 05 关于摄影师 —— 首页上的简短一段，完整内容在 /about。 */
import { SITE } from '../config/site';
import { withBase } from '../lib/paths';
---

<section class="about section" aria-labelledby="about-title">
  <div class="shell inner">
    <figure class="portrait reveal clip-reveal">
      <span class="frame portrait-frame">
        <img
          src={withBase(SITE.portrait)}
          alt={SITE.portraitAlt}
          sizes="(max-width: 860px) 60vw, 28vw"
          loading="lazy"
          decoding="async"
          data-loaded="false"
        />
      </span>
    </figure>

    <div class="text">
      <p class="eyebrow reveal" id="about-title">关于摄影师</p>
      <p class="lede reveal" style="--reveal-delay: 100ms">{SITE.tagline}</p>
      <p class="body-text reveal" style="--reveal-delay: 180ms">{SITE.statement}</p>
      <p class="reveal" style="--reveal-delay: 260ms">
        <a class="link" href={withBase('about')}>关于摄影师</a>
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--line);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .portrait {
    margin: 0;
    max-width: 26rem;
  }

  .portrait-frame {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--photo-rest);
    cursor: default;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    display: grid;
    gap: 1.25rem;
    align-content: center;
  }

  .text p {
    margin: 0;
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 18rem;
    }
  }
</style>
