---
/** 首页「关于摄影师」—— 正文在左（干净的一侧），人像在右（朱染的深色一侧）。 */
import { SITE } from '../config/site';
import { withBase } from '../lib/paths';
import ArtistBio from './ArtistBio.astro';
---

<section class="about section" aria-labelledby="about-title">
  <div class="shell inner">
    <div class="text">
      <p class="eyebrow reveal" id="about-title">关于摄影师</p>
      <ArtistBio />
    </div>

    <figure class="portrait reveal clip-reveal">
      <span class="frame portrait-frame">
        <img
          src={withBase(SITE.portrait)}
          alt={SITE.portraitAlt}
          sizes="(max-width: 860px) 60vw, 28vw"
          loading="lazy"
          decoding="async"
          data-loaded="false"
        />
      </span>
    </figure>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--line);
  }

  /*
    文字在左、人像在右。
    右侧是朱染的深色区，照片是不透明的所以不受影响，
    而正文留在干净的左半边，永远读得清。
  */
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .text {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .text > p {
    margin: 0;
  }

  .portrait {
    margin: 0;
    max-width: 26rem;
    width: 100%;
    justify-self: end;
  }

  .portrait-frame {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--photo-rest);
    cursor: default;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .portrait {
      order: 2;
      max-width: 18rem;
      justify-self: start;
    }
  }
</style>
