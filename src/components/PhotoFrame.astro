---
import type { Photo } from '../lib/gallery';
import { withBase } from '../lib/paths';
import { getLang, t } from '../lib/i18n';

interface Props {
  photo: Photo;
  /** 在完整作品集中的序号，Lightbox 用它做 "12 / 47" 和左右切换 */
  index: number;
  sizes?: string;
  eager?: boolean;
  /** 覆盖默认的缩略图来源，首页大图直接用 full 版本更清楚 */
  useFull?: boolean;
  /** 给了 href 就渲染成链接（进详情页），不给就是打开全屏看图的按钮 */
  href?: string;
  class?: string;
}

const {
  photo,
  index,
  sizes = '(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 31vw',
  eager = false,
  useFull = false,
  href,
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'button';

const imgSrc = withBase(useFull ? photo.src : photo.thumbnail);
const avifSrc = useFull ? undefined : photo.thumbnailAvif;

const ui = t(getLang(Astro.url));
const label = [photo.title, photo.location, photo.year].filter(Boolean).join('，');
const alt = label || ui.photoAlt(index + 1);
---

<Tag
  class:list={['frame', className]}
  style={`aspect-ratio: ${photo.width} / ${photo.height};`}
  href={href}
  data-lightbox-open={href ? undefined : true}
  data-index={href ? undefined : index}
  aria-label={`${ui.zoomPrefix}${alt}`}
>
  <picture>
    {avifSrc && <source type="image/avif" srcset={withBase(avifSrc)} sizes={sizes} />}
    <img
      src={imgSrc}
      width={photo.width}
      height={photo.height}
      alt={alt}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
      data-loaded="false"
    />
  </picture>
  {
    (photo.year || photo.location) && (
      <span class="frame-caption">
        {photo.location && <span>{photo.location}</span>}
        {photo.year && <span>{photo.year}</span>}
      </span>
    )
  }
</Tag>

<style>
  .frame {
    border: 0;
    padding: 0;
    text-align: left;
  }
</style>
