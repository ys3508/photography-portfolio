---
/** 作品墙的一屏：标题 + 分类标签 + masonry。中英文、各分类页共用。 */
import MasonryGallery from './MasonryGallery.astro';
import CategoryTabs from './CategoryTabs.astro';
import { getLang, t } from '../lib/i18n';
import { categoryName } from '../config/categories';
import type { Photo } from '../lib/gallery';

interface Props {
  items: Photo[];
  category?: string;
}
const { items, category } = Astro.props;

const lang = getLang(Astro.url);
const ui = t(lang);
const heading = category ? categoryName(category, lang) : ui.pageWorksTitle;
---

<section class="section">
  <div class="shell">
    <header class="section-head">
      <h1 class="section-title reveal">{heading}</h1>
      <p class="meta reveal">{ui.pageWorksHint}</p>
    </header>

    <CategoryTabs current={category} />

    {
      items.length > 0 ? (
        <MasonryGallery items={items} />
      ) : (
        <p class="body-text">{ui.emptyGallery}</p>
      )
    }
  </div>
</section>
