---
/**
 * 关于摄影师的正文。
 * 首页的「关于摄影师」一节和 /about 页面共用这一块，
 * 文字只在 src/config/site.ts 的 STATEMENT 里写一次。
 */
import { STATEMENT, STATEMENT_EN } from '../config/site';
import { renderEmphasis } from '../lib/text';
import { getLang } from '../lib/i18n';

const text = getLang(Astro.url) === 'en' ? STATEMENT_EN : STATEMENT;
---

<div class="bio">
  <p class="lead reveal">{text.lead}</p>

  <p class="para reveal" style="--reveal-delay: 90ms" set:html={renderEmphasis(text.opening)} />

  <p class="creed reveal" style="--reveal-delay: 160ms">{text.creed}</p>

  {
    text.body.map((para, i) => (
      <p class="para reveal" style={`--reveal-delay: ${220 + i * 70}ms`} set:html={renderEmphasis(para)} />
    ))
  }
</div>

<style>
  .bio {
    display: grid;
    gap: clamp(1.4rem, 2.4vw, 2rem);
    max-width: 36em;
  }

  .bio p {
    margin: 0;
  }

  .lead {
    font-family: var(--font-serif);
    font-size: clamp(1.3125rem, 1.9vw, 1.625rem);
    font-weight: 500;
    line-height: 1.55;
    color: var(--text);
    letter-spacing: 0.01em;
  }

  .para {
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.9;
    color: var(--text-muted);
  }

  /*
    手机上正文占满宽度，行末会靠近朱染那一侧，
    所以留出右边距让它提前折行，并把正文调深一档，保证读得清。
  */
  @media (max-width: 860px) {
    .bio {
      padding-right: 7%;
    }

    .para {
      color: var(--text);
      opacity: 0.88;
      font-size: 1.0625rem;
      line-height: 1.95;
    }
  }

  /* 「观看，是为了看见自己。」—— 整段文字的题眼，单独拎出来 */
  .creed {
    font-family: var(--font-serif);
    font-size: clamp(1.4375rem, 2.1vw, 1.8125rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--accent);
    padding-top: clamp(0.5rem, 1.5vw, 1rem);
    padding-left: clamp(0.9rem, 2vw, 1.4rem);
    border-left: 1px solid var(--accent);
    margin-block: clamp(0.25rem, 1vw, 0.75rem);
  }
</style>
