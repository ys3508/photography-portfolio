---
/**
 * 首页第一屏 —— 摄影杂志封面 / 摄影展入口。
 * 刻意不做 Hero Banner：没有按钮、没有 "Learn More"、没有大标语。
 *
 * 构图（原创）：左上是姓名，右侧一张代表作品，左下是那方印。
 * 中间大片留白，左缘透出大理石的肌理，右缘染着朱红。
 * 图版「定高、宽度按真实比例自动算」，所以照片永不被裁切，
 * 封面同时又能稳稳收在一屏之内。
 */
import { SITE } from '../config/site';
import { withBase } from '../lib/paths';
import { photos, heroPhotos, indexOf } from '../lib/gallery';
import MarbleGround from './MarbleGround.astro';
import { getLang, t } from '../lib/i18n';

const lang = getLang(Astro.url);
const ui = t(lang);

const lead = heroPhotos[0] ?? photos[0];

function describe(photo: typeof lead, fallback: string) {
  if (!photo) return fallback;
  return [photo.title, photo.location, photo.year].filter(Boolean).join('，') || fallback;
}

const leadAlt = describe(lead, ui.leadAlt);
---

<section class="cover" aria-label="封面">
  <MarbleGround variant="hero" />

  <div class="shell grid above-ground">
    <div class="masthead">
      <h1 class="display name">{lang === 'en' ? SITE.photographerNameLatin : SITE.photographerName}</h1>
      <span class="latin">{lang === 'en' ? SITE.photographerName : SITE.photographerNameLatin}</span>
    </div>

    {
      lead && (
        <figure class="plate">
          <button
            class="frame"
            style={`aspect-ratio: ${lead.width} / ${lead.height};`}
            data-lightbox-open
            data-index={indexOf(lead)}
            aria-label={`${ui.zoomPrefix}${leadAlt}`}
          >
            <img
              src={withBase(lead.src)}
              width={lead.width}
              height={lead.height}
              alt={leadAlt}
              sizes="(max-width: 860px) 100vw, 58vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-loaded="false"
            />
          </button>
        </figure>
      )
    }

    <figure class="seal tagline">
      <span class="seal-mark">{SITE.motto}</span>
      <figcaption class="seal-latin">{SITE.mottoLatin}</figcaption>
      <figcaption class="creed">
        {lang === 'zh' && <span class="creed-zh">{SITE.creed}</span>}
        <span class="creed-en">{SITE.creedLatin}</span>
      </figcaption>
    </figure>
  </div>

  <div class="scroll-cue" aria-hidden="true"><span></span></div>
</section>

<style>
  .cover {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(3.25rem, 6vh, 4.5rem) clamp(1.75rem, 4vh, 2.75rem);
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: clamp(0.5rem, 1.4vh, 1.1rem);
    width: 100%;
    align-items: end;
  }

  /* ---------- 刊头 ---------- */
  /* 名字与另一种写法排在同一行 —— 省下的高度全给照片 */
  .masthead {
    grid-column: 1 / 10;
    grid-row: 1;
    z-index: 3;
    pointer-events: none;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 clamp(0.75rem, 1.6vw, 1.5rem);
  }

  /* 字号收住 —— 和正文的差距不要太悬殊，照片才是主角 */
  .name {
    margin: 0;
    font-size: clamp(2.25rem, 4.3vw, 3.75rem);
    letter-spacing: 0.04em;
  }

  .latin {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* ---------- 代表作品：首页的 intro，给它最大的位置 ---------- */
  .plate {
    grid-column: 2 / 13;
    grid-row: 2;
    margin: 0;
    display: flex;
    justify-content: flex-end;
  }

  .plate .frame {
    height: clamp(17rem, 58svh, 40rem);
    width: auto;
    max-width: 100%;
    border: 0;
    padding: 0;
    display: block;
  }

  /* ---------- 印 ---------- */
  .tagline {
    grid-column: 1 / 9;
    grid-row: 3;
    margin: clamp(1rem, 2.2vh, 1.6rem) 0 0;
    gap: clamp(0.5rem, 0.9vw, 0.75rem);
  }

  .creed {
    display: grid;
    gap: 0.35rem;
    margin-top: clamp(0.4rem, 0.8vw, 0.65rem);
  }

  .creed-zh {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--text);
  }

  .creed-en {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  /* ---------- 滚动提示 ---------- */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    width: 1px;
    height: 2.5rem;
    background: var(--line);
    overflow: hidden;
  }

  .scroll-cue span {
    display: block;
    width: 100%;
    height: 40%;
    background: var(--text-muted);
    animation: cue 3.2s var(--ease) infinite;
  }

  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(250%);
    }
  }

  @media (max-height: 700px) {
    .cover {
      min-height: auto;
    }
  }

  /* ---------- 平板 / 手机 ---------- */
  @media (max-width: 860px) {
    .cover {
      min-height: auto;
      padding-block: clamp(3rem, 10vh, 5rem) clamp(2.5rem, 7vh, 3.5rem);
    }

    .grid {
      grid-template-columns: repeat(6, 1fr);
      align-items: start;
    }

    .masthead {
      grid-column: 1 / -1;
    }

    .plate {
      grid-column: 1 / -1;
      justify-content: stretch;
      margin-top: clamp(1rem, 4vw, 1.75rem);
    }

    .plate .frame {
      height: auto;
      width: 100%;
    }

    .tagline {
      grid-column: 1 / -1;
      margin-top: clamp(1.5rem, 6vw, 2.25rem);
    }

    .scroll-cue {
      display: none;
    }
  }
</style>
