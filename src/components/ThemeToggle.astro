---
/** 日 / 夜手动切换。状态与图标由 src/scripts/theme.ts 更新。 */
import { getLang, t } from '../lib/i18n';

const ui = t(getLang(Astro.url));
---

<button
  class="theme-toggle"
  data-theme-toggle
  type="button"
  aria-label={ui.themeToggle}
  title={ui.themeToggle}
>
  <span data-theme-icon aria-hidden="true">☀︎</span>
</button>

<style>
  .theme-toggle {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 1.0625rem;
    line-height: 1;
    color: inherit;
    transition: background-color 400ms var(--ease), opacity 400ms var(--ease);
    opacity: 0.75;
  }

  .theme-toggle:hover {
    opacity: 1;
    background: var(--photo-rest);
  }
</style>
