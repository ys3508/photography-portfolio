---
/**
 * 首页「精品集」——不是瀑布流，而是一本摄影书的内页编排。
 * 节奏：超大横图 → 竖图 + 留白 → 宽幅 → 两张互相对话的小图。
 * 完整的 masonry 照片墙在 /gallery 页面。
 */
import { editorialPhotos, featuredPhotos, indexOf } from '../lib/gallery';
import PhotoFrame from './PhotoFrame.astro';
import { getLang, t } from '../lib/i18n';

const ui = t(getLang(Astro.url));

const [one, two, three, four, five] = editorialPhotos;

/**
 * 版位不能假设照片是横是竖 —— 王宇挑哪几张是他的事，
 * 排版要能接住任何比例。横图铺得宽，竖图自动收窄，不然一张竖图满幅会高得离谱。
 */
const isWide = (p?: (typeof editorialPhotos)[number]) => !!p && p.width / p.height >= 1.15;
---

<section class="featured section" id="featured" aria-labelledby="featured-title">
  <div class="shell">
    <header class="section-head">
      <h2 class="section-title reveal" id="featured-title">{ui.selectedTitle}</h2>
    </header>

    <div class="spread">
      {
        one && (
          <div class:list={['slot', 'slot-one', 'reveal', 'clip-reveal', isWide(one) && 'is-wide']}>
            <PhotoFrame
              photo={one}
              index={indexOf(one, featuredPhotos)}
              useFull
              eager
              sizes="(max-width: 860px) 100vw, 82vw"
            />
          </div>
        )
      }

      {
        two && (
          <div class:list={['slot', 'slot-two', 'reveal', 'clip-reveal', isWide(two) && 'is-wide']}>
            <PhotoFrame photo={two} index={indexOf(two, featuredPhotos)} sizes="(max-width: 860px) 70vw, 34vw" />
          </div>
        )
      }


      {
        three && (
          <div class:list={['slot', 'slot-three', 'reveal', 'clip-reveal', isWide(three) && 'is-wide']}>
            <PhotoFrame
              photo={three}
              index={indexOf(three, featuredPhotos)}
              useFull
              sizes="(max-width: 860px) 100vw, 96vw"
            />
          </div>
        )
      }

      {
        four && (
          <div class:list={['slot', 'slot-four', 'reveal', 'clip-reveal', isWide(four) && 'is-wide']}>
            <PhotoFrame photo={four} index={indexOf(four, featuredPhotos)} sizes="(max-width: 860px) 46vw, 30vw" />
          </div>
        )
      }

      {
        five && (
          <div class:list={['slot', 'slot-five', 'reveal', 'clip-reveal', isWide(five) && 'is-wide']} style="--reveal-delay: 140ms">
            <PhotoFrame photo={five} index={indexOf(five, featuredPhotos)} sizes="(max-width: 860px) 46vw, 26vw" />
          </div>
        )
      }
    </div>

  </div>
</section>

<style>
  .featured {
    border-top: 1px solid var(--line);
  }

  .spread {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: clamp(3rem, 8vw, 6.5rem);
    align-items: start;
  }

  /*
    每张照片占的「面积」尽量接近 —— 差别太大会显得随意。
    做法不是统一宽度（那会让竖图高得离谱），而是按比例分配列数：
    竖构图占 5 列，横构图占 8 列，两者渲染出来的面积几乎相同。
    变化交给位置与错落，不交给大小。
  */
  .slot {
    grid-column: span 5;
  }

  .slot.is-wide {
    grid-column: span 8;
  }

  /* 01 开篇：尺寸和其余几张一样，只是居中独占一行 */
  .slot-one {
    grid-column: 4 / 9;
  }

  .slot-one.is-wide {
    grid-column: 3 / 11;
  }

  /* 02 / 03 一对：左右分开，右边那张往下错 */
  .slot-two {
    grid-column: 1 / 6;
  }

  .slot-two.is-wide {
    grid-column: 1 / 9;
  }

  .slot-three {
    grid-column: 8 / 13;
    margin-top: clamp(2.5rem, 7vw, 6rem);
  }

  .slot-three.is-wide {
    grid-column: 5 / 13;
  }

  /* 04 / 05 再一对：错落的方向反过来 */
  .slot-four {
    grid-column: 2 / 7;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .slot-four.is-wide {
    grid-column: 1 / 9;
  }

  .slot-five {
    grid-column: 8 / 13;
  }

  .slot-five.is-wide {
    grid-column: 5 / 13;
  }

  @media (max-width: 860px) {
    .spread {
      grid-template-columns: repeat(6, 1fr);
      row-gap: clamp(2.25rem, 7vw, 3.5rem);
    }

    .slot,
    .slot.is-wide,
    .slot-one,
    .slot-one.is-wide,
    .slot-two,
    .slot-two.is-wide,
    .slot-three,
    .slot-three.is-wide,
    .slot-four,
    .slot-four.is-wide,
    .slot-five,
    .slot-five.is-wide {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }
</style>
