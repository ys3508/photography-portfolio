---
/** 04 查看更多作品 —— 一条安静的横向预览带，把人领到完整照片墙。 */
import { photos, featuredPhotos, indexOf } from '../lib/gallery';
import { withBase } from '../lib/paths';
import PhotoFrame from './PhotoFrame.astro';

const featuredIds = new Set(featuredPhotos.map((p) => p.id));
// 只放还没在首页出现过的作品；不足两张就不摆这条预览带，一张孤零零的很难看
const strip = photos.filter((p) => !featuredIds.has(p.id)).slice(0, 4);
const total = photos.length;
---

<section class="more section" aria-labelledby="more-title">
  <div class="shell">
    <header class="section-head">
      <h2 class="section-title reveal" id="more-title">更多作品</h2>
      <p class="meta reveal">全部 {total} 张</p>
    </header>

    {
      strip.length >= 2 && (
        <div class="strip">
          {strip.map((photo, i) => (
            <div class="strip-item reveal clip-reveal" style={`--reveal-delay: ${i * 90}ms`}>
              <PhotoFrame photo={photo} index={indexOf(photo)} sizes="(max-width: 860px) 46vw, 23vw" />
            </div>
          ))}
        </div>
      )
    }

    <p class="cta reveal">
      <a class="link" href={withBase('gallery')}>进入完整摄影作品墙</a>
    </p>
  </div>
</section>

<style>
  .more {
    border-top: 1px solid var(--line);
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gutter);
    align-items: start;
  }

  .strip-item:nth-child(even) {
    margin-top: clamp(1.5rem, 4vw, 3.5rem);
  }

  .cta {
    margin: clamp(3rem, 8vw, 5.5rem) 0 0;
    text-align: center;
  }

  @media (max-width: 640px) {
    .strip {
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(0.75rem, 3vw, 1.25rem);
    }
  }
</style>
