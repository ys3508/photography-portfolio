---
import { SITE } from '../config/site';
import { getLang, localePath, t } from '../lib/i18n';

const lang = getLang(Astro.url);
const ui = t(lang);

const NAV = [
  { label: ui.navWorks, href: 'gallery' },
  { label: ui.navSelected, href: '#featured' },
  { label: ui.navAbout, href: 'about' },
];

const year = new Date().getFullYear();
const span =
  year > SITE.copyrightSince ? `${SITE.copyrightSince}–${year}` : `${SITE.copyrightSince}`;
---

<footer class="site-footer">
  <div class="shell inner">
    <div>
      <p class="name">{lang === 'en' ? SITE.photographerNameLatin : SITE.photographerName}</p>
      <p class="meta">
        {lang === 'en' ? SITE.photographerName : SITE.photographerNameLatin} · {ui.siteTagline}
      </p>
    </div>

    <nav class="links" aria-label="页脚导航">
      {
        NAV.map((item) => (
          <a
            class="meta"
            href={item.href.startsWith('#') ? localePath(lang) + item.href : localePath(lang, item.href)}
          >
            {item.label}
          </a>
        ))
      }
      {SITE.email && <a class="meta" href={`mailto:${SITE.email}`}>{ui.contact}</a>}
    </nav>

    <p class="meta copyright">
      © {span} {lang === 'en' ? SITE.photographerNameLatin : SITE.photographerName}. {ui.rights}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: clamp(2.25rem, 4vw, 3.5rem);
    height: 1px;
    background: var(--accent);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
  }

  .meta {
    margin: 0;
  }

  .links {
    display: flex;
    gap: 1.75rem;
  }

  .links a:hover {
    color: var(--text);
  }

  .copyright {
    flex-basis: 100%;
    color: var(--text-faint);
    font-size: 0.8125rem;
  }
</style>
