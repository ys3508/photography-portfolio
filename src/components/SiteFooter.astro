---
import { SITE, NAV } from '../config/site';
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();
const span =
  year > SITE.copyrightSince ? `${SITE.copyrightSince}–${year}` : `${SITE.copyrightSince}`;
---

<footer class="site-footer">
  <div class="shell inner">
    <div>
      <p class="name">{SITE.photographerName}</p>
      <p class="meta">{SITE.photographerNameLatin} · 个人摄影作品集</p>
    </div>

    <nav class="links" aria-label="页脚导航">
      {
        NAV.map((item) => (
          <a
            class="meta"
            href={item.href.startsWith('#') ? withBase('') + item.href : withBase(item.href)}
          >
            {item.label}
          </a>
        ))
      }
      {SITE.email && <a class="meta" href={`mailto:${SITE.email}`}>联系</a>}
    </nav>

    <p class="meta copyright">© {span} {SITE.photographerName}. 版权所有，未经许可请勿使用照片。</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: clamp(2.25rem, 4vw, 3.5rem);
    height: 1px;
    background: var(--accent);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
  }

  .meta {
    margin: 0;
  }

  .links {
    display: flex;
    gap: 1.75rem;
  }

  .links a:hover {
    color: var(--text);
  }

  .copyright {
    flex-basis: 100%;
    color: var(--text-faint);
    font-size: 0.6875rem;
  }
</style>
