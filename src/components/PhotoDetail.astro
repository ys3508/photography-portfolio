---
/** 单张作品的详情页内容。中英文共用。 */
import { withBase } from '../lib/paths';
import { getLang, localePath, t } from '../lib/i18n';
import { categoryName } from '../config/categories';
import { neighbours, photoSlug, type Photo } from '../lib/gallery';

interface Props {
  photo: Photo;
}
const { photo } = Astro.props;

const lang = getLang(Astro.url);
const ui = t(lang);
const { prev, next, index, total } = neighbours(photo);

const facts = [photo.location, photo.year].filter(Boolean);
const alt =
  [photo.title, photo.location, photo.year].filter(Boolean).join('，') || ui.photoAlt(index + 1);
const cat = photo.category ? categoryName(photo.category, lang) : '';
---

<article class="detail section">
  <div class="shell">
    <nav class="crumbs">
      <a class="link" href={localePath(lang, 'gallery')}>{ui.backToWorks}</a>
      {
        photo.category && (
          <a class="meta cat" href={localePath(lang, `gallery/${photo.category}`)}>
            {cat}
          </a>
        )
      }
    </nav>

    <figure class="stage reveal clip-reveal">
      <span class="frame" style={`aspect-ratio: ${photo.width} / ${photo.height};`}>
        <img
          src={withBase(photo.src)}
          width={photo.width}
          height={photo.height}
          alt={alt}
          sizes="(max-width: 860px) 100vw, 76vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-loaded="false"
        />
      </span>

      {
        (photo.title || facts.length > 0 || photo.caption) && (
          <figcaption class="caption reveal">
            {photo.title && <h1 class="title">{photo.title}</h1>}
            {facts.length > 0 && <p class="facts meta">{facts.join(' · ')}</p>}
            {photo.caption && <p class="body-text">{photo.caption}</p>}
          </figcaption>
        )
      }
    </figure>

    <nav class="pager">
      {
        prev ? (
          <a class="step prev" href={localePath(lang, `works/${photoSlug(prev)}`)}>
            <span aria-hidden="true">←</span> {ui.prevPhoto}
          </a>
        ) : (
          <span />
        )
      }

      <span class="count meta">{ui.photoOf(index + 1, total)}</span>

      {
        next ? (
          <a class="step next" href={localePath(lang, `works/${photoSlug(next)}`)}>
            {ui.nextPhoto} <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</article>

<style>
  .crumbs {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: clamp(1.75rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .cat {
    color: var(--accent);
    letter-spacing: 0.12em;
  }

  .stage {
    margin: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    justify-items: center;
  }

  /* 照片按真实比例，最多占一屏高度，永远不裁切 */
  .stage .frame {
    height: auto;
    width: auto;
    max-width: 100%;
    max-height: 78svh;
    cursor: default;
  }

  .stage .frame img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 78svh;
    object-fit: contain;
  }

  .caption {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    text-align: center;
    max-width: 34em;
  }

  .title {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    font-weight: 500;
    margin: 0;
  }

  .facts {
    margin: 0;
    letter-spacing: 0.12em;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  .step {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    transition: color 400ms var(--ease);
  }

  .step:hover {
    color: var(--accent);
  }

  .next {
    justify-self: end;
  }

  .count {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.16em;
  }

  /* 手机上「下一张」正好落在声音按钮下面，给它让出位置 */
  @media (max-width: 860px) {
    .pager {
      grid-template-columns: 1fr 1fr;
      row-gap: 1.25rem;
      padding-bottom: 4rem;
    }

    .count {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
    }

    .prev {
      grid-row: 2;
    }

    .next {
      grid-row: 2;
    }
  }
</style>
