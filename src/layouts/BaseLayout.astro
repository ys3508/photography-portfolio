---
import '../styles/global.css';
import { SITE, DAY_START, DAY_END } from '../config/site';
import { withBase } from '../lib/paths';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** 首页需要完全沉浸的封面，导航起始为透明叠加 */
  overlayHeader?: boolean;
}

const {
  title,
  description = SITE.description,
  overlayHeader = false,
} = Astro.props;

const pageTitle = title
  ? `${title} — ${SITE.photographerName}`
  : `${SITE.photographerName} — 个人摄影作品集`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
const ogImageUrl = new URL(withBase(SITE.ogImage), Astro.site ?? 'https://example.com').href;
---

<!doctype html>
<html lang="zh-CN" data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- 分享预览（微信 / 短信 / 家庭群） -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.photographerName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Inter:wght@300;400&family=Noto+Sans+SC:wght@300;400&family=Noto+Serif+SC:wght@300;400&display=swap"
    />

    <!--
      日 / 夜判断必须在首屏绘制之前执行，否则会闪一下白。
      这是全站唯一决定主题的地方：DAY_START / DAY_END 来自 src/config/site.ts。
    -->
    <script is:inline define:vars={{ DAY_START, DAY_END }}>
      (function () {
        var STORAGE_KEY = 'portfolio-theme';
        function byClock() {
          var h = new Date().getHours();
          return h >= DAY_START && h < DAY_END ? 'day' : 'night';
        }
        var saved = null;
        try {
          saved = localStorage.getItem(STORAGE_KEY);
        } catch (e) {
          /* 隐私模式下 localStorage 可能抛错，忽略即可 */
        }
        var theme = saved === 'day' || saved === 'night' ? saved : byClock();
        document.documentElement.setAttribute('data-theme', theme);
        // 暴露给 theme.ts 使用，避免时间判断散落在多个地方
        window.__themeConfig = {
          key: STORAGE_KEY,
          dayStart: DAY_START,
          dayEnd: DAY_END,
          byClock: byClock,
        };
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <SiteHeader overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      import '../scripts/theme';
      import '../scripts/reveal';
      import '../scripts/lightbox';
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        padding: 0.75rem 1.25rem;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--line-strong);
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }
    </style>
  </body>
</html>
